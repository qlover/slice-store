{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "rootDir": ".",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "outDir": "ts-build",
    "tsBuildInfoFile": "ts-build/.tsbuildinfo",
    "downlevelIteration": true,
    "strict": true,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "allowJs": true,
    "paths": {
      "@/*": ["src/*"],
      "@qlover/slice-store": ["../slice-store/src"]
    }
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "example/**/*",
    "*.config.ts",
    "package.json"
  ],
  "exclude": ["dist", "node_modules", "ts-build"],
  "references": [{ "path": "../slice-store" }]
}
