{
  "compilerOptions": {
    "target": "ESNEXT",
    "allowJs": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "outDir": "ts-build",
    "noEmit": false,
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "strict": true,
    "types": ["vitest/globals"],
    "paths": { "@qlover/slice-store": ["./packages/slice-store/src"] }
  },
  "include": ["make", "vitest.config.ts"],
  "exclude": ["**/node_modules/*", "**/dist", "**/build"],
  "references": [
    { "path": "./packages/slice-store" },
    { "path": "./packages/slice-store-react" }
  ]
}
