{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,
    "rootDir": ".",
    "moduleResolution": "bundler"
  },
  "include": [
    "packages/**/__tests__/**/*.{ts,tsx}",
    "packages/**/src/**/*.{ts,tsx}",
    "packages/**/package.json"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/ts-build/**"
  ]
}
