{
  "compilerOptions": {
    "allowJs": false,
    "target": "ESNEXT",
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "outDir": "ts-build",
    "baseUrl": ".",
    "noEmit": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "checkJs": false,
    "incremental": true,
    "strict": true,
    "types": ["vitest/globals"],
    "paths": {
      "@qlover/slice-store": ["./packages/slice-store/src"]
    }
  }
}
